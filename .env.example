TUSHARE_TOKEN=
TUSHARE_CALLS_PER_MINUTE=120
TUSHARE_DAILY_BUDGET=5000
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
DATABASE_URL=sqlite:///./data/stock_analysis.db
USE_MOCK_DATA=true
QUOTE_REFRESH_SECONDS=30
BOOTSTRAP_HISTORY_DAYS=90
NEWS_REFRESH_MINUTES=15
# 真实 akshare 模式下，新闻增量除自选股外并入综合评分前 N 名；0=仅自选
NEWS_TOP_N=0
ENABLE_SCHEDULER=true
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# 允许访问的 Host（TrustedHostMiddleware），公网 IP 部署需加入服务器公网 IP
ALLOWED_HOSTS=127.0.0.1,localhost

# —— 微信推送（企业微信群机器人）——
# 企业微信建一个只有自己的群 → 群设置 → 群机器人 → 添加 → 复制 Webhook 地址，粘在这里。
# 这个地址是**凭据**：拿到它的人可以往那个群发任意消息。只填在服务器的 .env 里，不要提交。
# get_settings() 是 lru_cache，**改完必须重启服务**，否则一直是「未配置」。
WECOM_WEBHOOK_URL=
# 显式开关；与 webhook 非空两条同时成立才推送。关掉时每次推送只记一行 skipped。
NOTIFY_ENABLED=true
# 企业微信 markdown 上限 4096 字节，留余量
NOTIFY_MAX_BYTES=4000
# 假定本金。页面上的 equity 是 URL 参数且影响「加仓」判定，这里填与页面一致的值，
# 否则同一只票同一根收盘，网页说加仓而推送说继续持有。
NOTIFY_EQUITY=1000000
# 傍晚日报的整点（交易日 19:00 推送，晚于 18:45 的全市场池化）
NOTIFY_DAILY_HOUR=19
